{
  "name": "nemoodarestan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "dev:gallery": "vite --host 127.0.0.1",
    "install:studios": "node scripts/install-studios.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-studios.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:studios": "node scripts/test-studios.mjs",
    "check": "tsc --noEmit && npm test",
    "build:portable": "node scripts/build-portable.mjs",
    "previews": "node scripts/generate-previews.mjs && node scripts/generate-series-previews.mjs && node scripts/generate-radial-previews.mjs && node scripts/generate-comparison-previews.mjs && node scripts/generate-business-previews.mjs && node scripts/generate-motion-previews.mjs && node scripts/generate-multivariate-previews.mjs && node scripts/generate-network-waterfall-previews.mjs"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-shape": "3.1.7",
    "@types/papaparse": "5.3.16",
    "typescript": "~5.9.3",
    "vite": "6.4.1"
  },
  "dependencies": {
    "d3-hierarchy": "3.1.2",
    "d3-shape": "3.2.0",
    "papaparse": "5.5.3",
    "xlsx": "0.18.5"
  }
}
